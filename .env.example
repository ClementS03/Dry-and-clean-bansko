# Copiez ce fichier en .env.local et remplissez les valeurs.
# Les memes variables doivent exister sur Netlify, dans Site settings,
# Environment variables. Ne commitez jamais .env.local.

# Avis clients, lus depuis Notion par /api/reviews
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Envoi des demandes de devis par /api/contact.
# Sans cette cle, le formulaire desktop echoue. En developpement le lead
# est affiche dans la console du serveur a la place.
RESEND_API_KEY=
